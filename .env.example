# Copy to .env.local and fill in. Never commit .env.local.
# Variables are validated at runtime by src/config (see PROJECT_ARCHITECTURE.md §11).

# ── Public (inlined into the browser bundle — never put secrets here) ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only ────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent   (default: info)
LOG_LEVEL=info

# Used by the Phase 6.2+ cron/delivery path only (src/app/api/cron/notifications/route.ts);
# never used by any user-facing request path.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret POST /api/cron/notifications requires (Phase 6.2). Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>` once set. Leave unset in local dev and
# the route simply refuses every request (401) — it is never a publicly callable mutation path.
CRON_SECRET=

# ── AI planning (optional; the app works without them) ────────────────────────
# Both must be set for AI proposals to be available. Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Web Push (Phase 6.1 subscription registration + Phase 6.3 delivery; optional) ─────────────
# The VAPID public key browsers need for PushManager.subscribe(). Safe to expose — it is not a
# secret, only the matching private key is. Leave all three of these unset and "Enable
# notifications" is simply unavailable / no reminder is ever sent — the same graceful
# degradation ANTHROPIC_API_KEY gets; nothing here is required for the app to run.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never log, never send to AI. Generate a real
# pair with `npx web-push generate-vapid-keys` when actually deploying delivery — this file
# never contains one.
VAPID_PRIVATE_KEY=
# A contact URI the push services can reach you at if something's wrong with your requests —
# either "mailto:you@example.com" or an "https://" URL. Server-only, not a secret.
VAPID_SUBJECT=

# ── Later phases (declared now so the contract is visible; not yet read) ───────
# RESEND_API_KEY=
# EMAIL_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
